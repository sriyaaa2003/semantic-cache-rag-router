# Deployment settings. Runtime behaviour (thresholds, router, prompts, model prices) is stored in the
# database and managed with `ragcache config` / `ragcache models`, not here.
RC_DB_PATH=ragcache.db
RC_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Required for ingestion, config, models and metrics endpoints (use a long random value).
RC_ADMIN_API_KEY=
# Optional. If set, /v1/query requires it in the X-API-Key header.
RC_QUERY_API_KEY=
RC_LOG_LEVEL=INFO
RC_LLM_TIMEOUT_SECONDS=60
RC_LLM_MAX_RETRIES=2
# Provider keys are NOT configured here. Each row in the models table names the environment
# variable that holds its key (e.g. ANTHROPIC_API_KEY); export that variable yourself.
